# alert-system 本地开发环境变量样例。复制为 .env 后按需修改
# （.gitignore 已排除 .env，仅本文件 .env.example 入库）。
#
# 服务端不读取 .env 文件本身，需要先 source 到 shell 环境变量，再启动进程：
#   set -a; source .env; set +a
#   go run ./cmd/server

# --- 数据库 ---
# 对应 deploy/docker-compose.yml 暴露的本地端口 5433（5432 已被其他项目占用）。
DB_DSN=postgres://alert_system:alert_system@localhost:5433/alert_system?sslmode=disable

# --- HTTP 服务 ---
HTTP_PORT=8080

# --- 统一定时器轮询间隔 ---
SCHEDULER_POLL_INTERVAL=5s

# --- 飞书开放平台凭据（通知渠道 + 卡片回调验签，均留空表示不启用） ---
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# --- 登录会话 ---
SESSION_TTL=168h
SESSION_IDLE_TTL=30m
# 本地用 http（非 https）联调时必须设为 false，否则浏览器不会回传 Secure cookie
# 导致登录后立即被判定未登录。生产环境（https）务必改回 true。
SESSION_COOKIE_SECURE=false

# --- 通知生命周期 ---
REPEAT_INTERVAL=30m
