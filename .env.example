# alert-system 本地开发环境变量样例。复制为 .env 后按需修改
# （.gitignore 已排除 .env，仅本文件 .env.example 入库）。
#
# 服务端不读取 .env 文件本身，需要先 source 到 shell 环境变量，再启动进程：
#   set -a; source .env; set +a
#   go run ./cmd/server

# --- 数据库 ---
# 对应 deploy/docker-compose.yml 暴露的本地端口 5433（5432 已被其他项目占用）。
DB_DSN=postgres://alert_system:alert_system@localhost:5433/alert_system?sslmode=disable

# --- HTTP 服务 ---
HTTP_PORT=8080

# --- 统一定时器轮询间隔 ---
SCHEDULER_POLL_INTERVAL=5s

# --- 飞书开放平台凭据（通知渠道 + 卡片回调验签，均留空表示不启用） ---
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# --- 登录会话 ---
SESSION_TTL=168h
SESSION_IDLE_TTL=30m
# 本地用 http（非 https）联调时必须设为 false，否则浏览器不会回传 Secure cookie
# 导致登录后立即被判定未登录。生产环境（https）务必改回 true。
SESSION_COOKIE_SECURE=false

# --- 通知生命周期 ---
REPEAT_INTERVAL=30m

# --- Service Observability（三层 /services 只读聚合边界） ---
# Profile 目录留空是合法的空 registry：总览显示 Unconfigured、工作区返回 409。
# 显式配置但不可读会让启动失败，避免误以为 Profile 已加载。
SERVICE_OBSERVABILITY_PROFILE_DIR=
# 目录摘要缓存：TTL 内直接返回，TTL~max stale 之间显式 Stale 并后台刷新，
# 超过 max stale 旧值彻底不可见（退化为 Unknown，不显示过期绿值）。
SERVICE_OBSERVABILITY_CACHE_TTL=45s
SERVICE_OBSERVABILITY_CACHE_MAX_STALE=5m
SERVICE_OBSERVABILITY_CACHE_MAX_ENTRIES=4096
# 固定 worker 数与 bounded queue：队列满时保留 Unknown/Stale，不额外起 goroutine。
SERVICE_OBSERVABILITY_REFRESH_WORKERS=4
SERVICE_OBSERVABILITY_REFRESH_QUEUE=256
# 全局时间窗上界；每次请求的有效上界取它与 Profile limits 的最小值。
SERVICE_OBSERVABILITY_MAX_WINDOW_SECONDS=86400

# --- Phase 3 只读遥测 provider ---
# endpoint 留空是合法的"未连接"：启动成功，对应来源在页面上显式 Unknown。
# 显式配置但非法（非 https、带 userinfo/query/fragment、含控制字符）会让启动失败——
# 静默兜底会让"配置写错"看起来像"配置生效了"。生产只接受 https；明文 http 仅测试代码
# 显式构造 loopback 模式时可用，没有任何 YAML 或环境变量开关能切换它。
SERVICE_OBSERVABILITY_PROMETHEUS_ENDPOINT=
SERVICE_OBSERVABILITY_OPENOBSERVE_ENDPOINT=
SERVICE_OBSERVABILITY_OPENOBSERVE_ORGANIZATION=
# 认证模式显式为 none|basic|bearer。凭据本身**不**从这里读：这些项只写"引用"（另一个环境
# 变量的名字，或一个文件路径），值由被引用的 env 或文件提供。也就是说要保护的是引用目标，
# 这份文件里的每一项都只是指针。这条不对称是刻意的——进程环境是最容易被误导出的地方。
# 每对 *_ENV / *_FILE 互斥；文件必须是常规文件且不超过 4 KiB，读取按 fd 有界进行。
# username 与 password/token 同级：它也只能来自引用，没有直填形式。
# 凭据里的冒号（仅 username）与控制字符会在启动时被拒绝，而不是等到构造请求时才发现。
# 未连接的 provider 声明凭据会让启动失败：那通常意味着部署者以为已经接上了。
# 配置结构体的 String/GoString/JSON/slog 输出一律是安全表示（连 username 与 organization
# 都不输出），因此把整份配置打进日志也不会泄露。YAML 里没有任何能装凭据值的字段。
#
# OpenObserve 实测是 Basic user:password 形态，因此不能只提供 bearer token。
SERVICE_OBSERVABILITY_PROMETHEUS_AUTH_MODE=
SERVICE_OBSERVABILITY_PROMETHEUS_AUTH_USERNAME_ENV=
SERVICE_OBSERVABILITY_PROMETHEUS_AUTH_USERNAME_FILE=
SERVICE_OBSERVABILITY_PROMETHEUS_AUTH_PASSWORD_ENV=
SERVICE_OBSERVABILITY_PROMETHEUS_AUTH_PASSWORD_FILE=
SERVICE_OBSERVABILITY_PROMETHEUS_AUTH_TOKEN_ENV=
SERVICE_OBSERVABILITY_PROMETHEUS_AUTH_TOKEN_FILE=
SERVICE_OBSERVABILITY_OPENOBSERVE_AUTH_MODE=
SERVICE_OBSERVABILITY_OPENOBSERVE_AUTH_USERNAME_ENV=
SERVICE_OBSERVABILITY_OPENOBSERVE_AUTH_USERNAME_FILE=
SERVICE_OBSERVABILITY_OPENOBSERVE_AUTH_PASSWORD_ENV=
SERVICE_OBSERVABILITY_OPENOBSERVE_AUTH_PASSWORD_FILE=
SERVICE_OBSERVABILITY_OPENOBSERVE_AUTH_TOKEN_ENV=
SERVICE_OBSERVABILITY_OPENOBSERVE_AUTH_TOKEN_FILE=
# 每个来源独立的超时与限额。超时上界 30s；响应字节、并发、行数与 series 基数都必须为正，
# 超限显式失败而不是截断出一个"看起来完整"的结果。
SERVICE_OBSERVABILITY_PROMETHEUS_TIMEOUT=5s
SERVICE_OBSERVABILITY_PROMETHEUS_MAX_RESPONSE_BYTES=8388608
SERVICE_OBSERVABILITY_PROMETHEUS_MAX_CONCURRENT=8
SERVICE_OBSERVABILITY_PROMETHEUS_MAX_ROWS=200
SERVICE_OBSERVABILITY_PROMETHEUS_MAX_SERIES=500
SERVICE_OBSERVABILITY_OPENOBSERVE_TIMEOUT=5s
SERVICE_OBSERVABILITY_OPENOBSERVE_MAX_RESPONSE_BYTES=8388608
SERVICE_OBSERVABILITY_OPENOBSERVE_MAX_CONCURRENT=8
SERVICE_OBSERVABILITY_OPENOBSERVE_MAX_ROWS=200
SERVICE_OBSERVABILITY_OPENOBSERVE_MAX_SERIES=500
# Evidence deep link 的最长有效期（硬上界 24h）；实际 TTL 取它与上游剩余 retention 的
# 最小值。一个长期有效的 deep link 等于一张长期通行证。
SERVICE_OBSERVABILITY_EVIDENCE_GRANT_TTL=15m
# 工具调用审计保留天数与过期 grant 的单批清理行数（由既有 retention_sweep 执行）。
SERVICE_OBSERVABILITY_AUDIT_RETENTION_DAYS=30
SERVICE_OBSERVABILITY_GRANT_CLEANUP_BATCH=500
# 后台目录刷新对同一服务的最小间隔。它是审计写放大的闸门：没有下界会把审计表刷爆。
SERVICE_OBSERVABILITY_BACKGROUND_REFRESH_MIN_INTERVAL=30s

# --- 前端显式开发 fixture 模式（web/，仅 dev server 生效） ---
# 只有 import.meta.env.DEV 且本项为 'true' 时，三层 /services 页面才读取契约
# fixtures/scenarios 做产品 demo 与视觉 QA。production build 在任何取值下都走真实
# API 与 AuthGate；API 失败也绝不回落 fixture。
VITE_SERVICE_OBSERVABILITY_FIXTURE_MODE=false
