{
  "schema_version": "1.0",
  "package_key": "postgresql_core",
  "package_version": 1,
  "status": "draft",
  "description": "结构与 E2B 明显不同的最小 package：实例级 focus、没有任何 journey、只用 Golden 与 USE、不声明 request_journey/dependency_topology renderer。它存在的唯一目的是证明同一份 SIP 契约与compiler 能表达非请求旅程型服务，核心 renderer/assembler 不需要新增分支。metric、stream 与字段形状未经 discovery，是 draft，不是 Phase 4 的产品验收物。",
  "compatibility": {
    "profile_schema_version": "1.0",
    "min_compiler_version": 1
  },
  "target": {
    "environment": "production",
    "service_selector": {
      "entity_key": "infrastructure:postgresql-core"
    },
    "root_selectors": [
      {
        "entity_key": "infrastructure:postgresql-core:primary"
      }
    ]
  },
  "profile_template": {
    "profile_key": "postgresql_core",
    "focus_kinds": [
      {
        "key": "database_name",
        "label": "数据库名",
        "value_pattern": "^[a-z][a-z0-9_]{0,62}$",
        "placeholder": "alert_system",
        "primary": true
      }
    ],
    "journeys": [],
    "views": [
      {
        "key": "overview",
        "renderer": "golden_overview",
        "title": "四大黄金信号",
        "order": 10,
        "signal_refs": [
          "golden_query_latency",
          "golden_query_traffic",
          "golden_query_errors",
          "golden_connection_saturation"
        ],
        "tool_refs": [
          "metrics.query_semantic_signal.v1"
        ]
      },
      {
        "key": "instance_capacity",
        "renderer": "resource_fleet",
        "title": "实例资源",
        "order": 20,
        "signal_refs": [
          "use_connection_utilization"
        ],
        "tool_refs": [
          "metrics.query_semantic_signal.v1"
        ]
      },
      {
        "key": "timeline",
        "renderer": "domain_timeline",
        "title": "事件时间线",
        "order": 30,
        "tool_refs": [
          "domain.list_service_faults.v1"
        ]
      }
    ],
    "signal_bindings": [
      {
        "key": "golden_query_latency",
        "label": "语句延迟 P95",
        "family": "golden",
        "semantic": "latency",
        "scope": {
          "kind": "service"
        },
        "tool_key": "metrics.query_semantic_signal.v1",
        "output_field": "series.quantile_value",
        "unit": "ms",
        "aggregation": "p95",
        "thresholds": {
          "mode": "absolute",
          "direction": "above",
          "degraded": 200,
          "critical": 1000
        }
      },
      {
        "key": "golden_query_traffic",
        "label": "语句吞吐",
        "family": "golden",
        "semantic": "traffic",
        "scope": {
          "kind": "service"
        },
        "tool_key": "metrics.query_semantic_signal.v1",
        "output_field": "series.rate_per_second",
        "unit": "req/s",
        "aggregation": "rate"
      },
      {
        "key": "golden_query_errors",
        "label": "语句错误率",
        "family": "golden",
        "semantic": "errors",
        "scope": {
          "kind": "service"
        },
        "tool_key": "metrics.query_semantic_signal.v1",
        "output_field": "series.ratio_percent",
        "unit": "%",
        "aggregation": "avg",
        "thresholds": {
          "mode": "absolute",
          "direction": "above",
          "degraded": 1,
          "critical": 5
        }
      },
      {
        "key": "golden_connection_saturation",
        "label": "连接数饱和度",
        "family": "golden",
        "semantic": "saturation",
        "scope": {
          "kind": "service"
        },
        "tool_key": "metrics.query_semantic_signal.v1",
        "output_field": "series.ratio_percent",
        "unit": "%",
        "aggregation": "max",
        "thresholds": {
          "mode": "absolute",
          "direction": "above",
          "degraded": 80,
          "critical": 95
        }
      },
      {
        "key": "use_connection_utilization",
        "label": "实例连接使用率",
        "family": "use",
        "semantic": "utilization",
        "scope": {
          "kind": "resource",
          "entity_selectors": [
            {
              "entity_key": "infrastructure:postgresql-core:primary"
            }
          ]
        },
        "tool_key": "metrics.query_semantic_signal.v1",
        "output_field": "series.ratio_percent",
        "unit": "%",
        "aggregation": "max",
        "thresholds": {
          "mode": "absolute",
          "direction": "above",
          "degraded": 80,
          "critical": 95
        }
      }
    ],
    "tool_refs": [
      "metrics.query_semantic_signal.v1",
      "domain.list_service_faults.v1"
    ],
    "limits": {
      "default_window_seconds": 300,
      "max_window_seconds": 86400,
      "max_nodes": 20,
      "max_relations": 40,
      "max_rows": 200,
      "max_evidence_refs": 20,
      "freshness_ttl_seconds": 120
    }
  },
  "topology_policy": {
    "alias_namespaces": [
      "pg_instance"
    ],
    "overlay": {
      "stale_after_seconds": 600
    }
  },
  "provider_bindings": [
    {
      "key": "signal_golden_query_latency",
      "kind": "signal",
      "target_ref": "golden_query_latency",
      "tool_key": "metrics.query_semantic_signal.v1",
      "template_ref": "histogram_quantile_rate.v1",
      "params": {
        "bucket_metric": "pg_stat_statements_exec_time_bucket",
        "labels": [
          {
            "name": "job",
            "value": "postgres-exporter"
          }
        ],
        "quantile": 0.95,
        "range_seconds": 300
      }
    },
    {
      "key": "signal_golden_query_traffic",
      "kind": "signal",
      "target_ref": "golden_query_traffic",
      "tool_key": "metrics.query_semantic_signal.v1",
      "template_ref": "counter_rate.v1",
      "params": {
        "metric": "pg_stat_database_xact_commit_total",
        "labels": [
          {
            "name": "job",
            "value": "postgres-exporter"
          }
        ],
        "range_seconds": 300
      }
    },
    {
      "key": "signal_golden_query_errors",
      "kind": "signal",
      "target_ref": "golden_query_errors",
      "tool_key": "metrics.query_semantic_signal.v1",
      "template_ref": "counter_ratio_percent.v1",
      "params": {
        "numerator_metric": "pg_stat_database_xact_rollback_total",
        "denominator_metric": "pg_stat_database_xact_commit_total",
        "range_seconds": 300,
        "common_labels": [
          {
            "name": "job",
            "value": "postgres-exporter"
          }
        ]
      }
    },
    {
      "key": "signal_golden_connection_saturation",
      "kind": "signal",
      "target_ref": "golden_connection_saturation",
      "tool_key": "metrics.query_semantic_signal.v1",
      "template_ref": "gauge_ratio_percent.v1",
      "params": {
        "total_metric": "pg_settings_max_connections",
        "free_metric": "pg_stat_database_numbackends",
        "labels": [
          {
            "name": "job",
            "value": "postgres-exporter"
          }
        ]
      }
    },
    {
      "key": "signal_use_connection_utilization",
      "kind": "signal",
      "target_ref": "use_connection_utilization",
      "tool_key": "metrics.query_semantic_signal.v1",
      "template_ref": "gauge_ratio_percent.v1",
      "params": {
        "total_metric": "pg_settings_max_connections",
        "free_metric": "pg_stat_database_numbackends",
        "labels": [
          {
            "name": "job",
            "value": "postgres-exporter"
          }
        ],
        "group_by": [
          "instance"
        ]
      }
    }
  ]
}
