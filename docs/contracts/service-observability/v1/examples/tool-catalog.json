        "root_entity_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "observed_at", "partial", "nodes", "relations"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "partial": { "type": "boolean" },
        "nodes": { "type": "array", "items": { "type": "object" } },
        "relations": { "type": "array", "items": { "type": "object" } }
      }
    },
    "query_template_ref": "alert-system:topology:expand-neighbors:v1",
    "required_permissions": ["services.read", "topology.read"],
    "limits": { "timeout_ms": 3000, "max_window_seconds": 86400, "max_rows": 5000, "max_cardinality": 1000 },
    "freshness_ttl_seconds": 60,
    "audit": { "log_invocation": true, "log_result_metadata": true },
    "redaction": { "policy_ref": "redaction:observability:default:v1", "deny_raw_secrets": true }
  },
  {
    "schema_version": "1.0",
