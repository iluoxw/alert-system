        "series": { "type": "object", "additionalProperties": { "type": "number" } },
        "observed_at": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale", "unknown"] }
      }
    },
    "query_template_ref": "prometheus-compatible:metrics:semantic-signal:v1",
    "required_permissions": ["services.read", "metrics.read"],
    "limits": { "timeout_ms": 5000, "max_window_seconds": 86400, "max_rows": 2000, "max_cardinality": 1000 },
