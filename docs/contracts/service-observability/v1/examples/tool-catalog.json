[
  {
    "schema_version": "1.0",
    "key": "context.resolve_focus.v1",
    "semantic_version": "1.0.0",
    "category": "context",
    "source_adapter": "alert_system",
    "description": "Resolve a profile-declared focus value to visible service entities and a bounded time range.",
    "read_only": true,
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "focus_kind", "focus_value", "from", "to"],
      "properties": {
        "service_id": { "type": "string" },
        "focus_kind": { "type": "string" },
        "focus_value": { "type": "string" },
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched", "entity_ids", "evidence_refs"],
      "properties": {
        "matched": { "type": "boolean" },
        "entity_ids": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "object" } }
      }
    },
    "query_template_ref": "alert-system:context:resolve-focus:v1",
    "required_permissions": ["services.read", "evidence.read"],
    "limits": { "timeout_ms": 3000, "max_window_seconds": 86400, "max_rows": 100, "max_cardinality": 100 },
    "freshness_ttl_seconds": 30,
    "audit": { "log_invocation": true, "log_result_metadata": true },
    "redaction": { "policy_ref": "redaction:observability:default:v1", "deny_raw_secrets": true }
  },
  {
    "schema_version": "1.0",
