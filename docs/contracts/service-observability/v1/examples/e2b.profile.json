{
  "schema_version": "1.0",
  "profile_key": "e2b",
  "profile_version": 1,
  "status": "published",
  "service_ref": {
    "service_id": "svc_e2b_fixture",
    "root_entity_ids": ["entity_e2b_api", "entity_e2b_orchestrator"]
  },
  "focus_kinds": [
    {
      "key": "sandbox_id",
      "label": "Sandbox ID",
      "value_pattern": "^sbx_[A-Za-z0-9]+$",
      "placeholder": "sbx_hp16c3",
      "primary": true
    },
    {
      "key": "trace_id",
      "label": "Trace ID",
      "value_pattern": "^[A-Fa-f0-9]{16,32}$",
      "placeholder": "输入 Trace ID",
      "primary": false
    }
  ],
  "journeys": [
    {
      "key": "sandbox_create",
      "label": "Sandbox 创建",
      "focus_kind": "sandbox_id",
      "stages": [
        {
          "key": "accept",
          "label": "ACCEPT",
          "entity_refs": ["entity_e2b_api"]
        },
        {
          "key": "place",
          "label": "PLACE",
          "entity_refs": ["entity_e2b_orchestrator"],
          "relation_refs": ["rel_api_orchestrator"]
        },
        {
          "key": "fc_start",
          "label": "FC START",
          "entity_refs": ["entity_e2b_sandbox_pool"]
        },
        {
          "key": "envd_ready",
          "label": "ENVD READY",
          "entity_refs": ["entity_e2b_envd"]
        },
        {
          "key": "routed",
          "label": "ROUTED",
          "entity_refs": ["entity_e2b_traefik"]
        }
      ]
    }
  ],
  "views": [
    {
      "key": "overview",
      "renderer": "golden_overview",
      "title": "四大黄金信号",
      "order": 10,
      "signal_refs": [
        "golden_create_latency",
        "golden_create_traffic",
        "golden_create_errors",
        "golden_capacity_saturation"
      ],
      "tool_refs": ["metrics.query_semantic_signal.v1"]
    },
    {
      "key": "create_journey",
      "renderer": "request_journey",
      "title": "Sandbox 创建阶段",
      "order": 20,
      "journey_ref": "sandbox_create",
      "tool_refs": ["context.resolve_focus.v1", "evidence.search_traces.v1"]
    },
    {
      "key": "request_topology",
      "renderer": "dependency_topology",
      "title": "请求与依赖拓扑",
      "order": 30,
      "signal_refs": ["red_api_orchestrator_rate", "red_api_orchestrator_errors", "red_api_orchestrator_duration"],
      "tool_refs": ["topology.expand_neighbors.v1", "metrics.query_semantic_signal.v1"]
    },
    {
      "key": "host_capacity",
      "renderer": "resource_fleet",
      "title": "宿主机与资源池",
      "order": 40,
      "signal_refs": ["use_host_hugepages_utilization", "use_host_placement_saturation", "use_host_placement_errors"],
      "tool_refs": ["metrics.query_semantic_signal.v1"]
    },
    {
      "key": "evidence",
      "renderer": "evidence_list",
      "title": "证据",
      "order": 50,
      "tool_refs": ["evidence.search_logs.v1", "evidence.search_traces.v1"]
    },
    {
      "key": "timeline",
      "renderer": "domain_timeline",
      "title": "事件时间线",
      "order": 60,
      "tool_refs": ["domain.list_service_faults.v1"]
    }
  ],
  "signal_bindings": [
    {
      "key": "golden_create_latency",
      "label": "创建延迟 P95",
      "family": "golden",
      "semantic": "latency",
      "scope": { "kind": "service" },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.p95_ms",
      "unit": "ms",
      "aggregation": "p95",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 3000,
        "critical": 8000
      }
    },
    {
      "key": "golden_create_traffic",
      "label": "创建流量",
      "family": "golden",
      "semantic": "traffic",
      "scope": { "kind": "service" },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.creates_per_minute",
      "unit": "creates/min",
      "aggregation": "rate",
      "baseline_ref": "baseline:e2b:create_traffic:7d_same_hour"
    },
    {
      "key": "golden_create_errors",
      "label": "创建错误率",
      "family": "golden",
      "semantic": "errors",
      "scope": { "kind": "service" },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.error_percent",
      "unit": "percent",
      "aggregation": "avg",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 5,
        "critical": 15
      }
    },
    {
      "key": "golden_capacity_saturation",
      "label": "最坏资源饱和度",
      "family": "golden",
      "semantic": "saturation",
      "scope": { "kind": "resource", "refs": ["entity_e2b_host_fleet"] },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.max_capacity_pressure_percent",
      "unit": "percent",
      "aggregation": "max",
      "measurement_role": "proxy",
      "proxy_reason": "Phase 1 使用最坏宿主 HugePages 使用率近似服务容量压力；真实 placement saturation 指标接入前不得解释为排队压力。",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 85,
        "critical": 95
      }
    },
    {
      "key": "red_api_orchestrator_rate",
      "label": "API 到 Orchestrator 请求率",
      "family": "red",
      "semantic": "rate",
      "scope": { "kind": "relation", "refs": ["rel_api_orchestrator"] },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.requests_per_second",
      "unit": "req/s",
      "aggregation": "rate"
    },
    {
      "key": "red_api_orchestrator_errors",
      "label": "API 到 Orchestrator 错误率",
      "family": "red",
      "semantic": "errors",
      "scope": { "kind": "relation", "refs": ["rel_api_orchestrator"] },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.error_percent",
      "unit": "percent",
      "aggregation": "avg",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 2,
        "critical": 5
      }
    },
    {
      "key": "red_api_orchestrator_duration",
      "label": "API 到 Orchestrator P95",
      "family": "red",
      "semantic": "duration",
      "scope": { "kind": "relation", "refs": ["rel_api_orchestrator"] },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.p95_ms",
      "unit": "ms",
      "aggregation": "p95",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 1000,
        "critical": 3000
      }
    },
    {
      "key": "use_host_hugepages_utilization",
      "label": "HugePages 使用率",
      "family": "use",
      "semantic": "utilization",
      "scope": { "kind": "resource", "refs": ["entity_e2b_host_fleet"] },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.hugepages_utilization_percent",
      "unit": "percent",
      "aggregation": "max",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 85,
        "critical": 95
      }
    },
    {
      "key": "use_host_placement_saturation",
      "label": "Placement 资源饱和度",
      "family": "use",
      "semantic": "saturation",
      "scope": { "kind": "resource", "refs": ["entity_e2b_host_fleet"] },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.placement_saturation_percent",
      "unit": "percent",
      "aggregation": "max",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 85,
        "critical": 95
      }
    },
    {
      "key": "use_host_placement_errors",
      "label": "Placement 资源拒绝率",
      "family": "use",
      "semantic": "errors",
      "scope": { "kind": "resource", "refs": ["entity_e2b_host_fleet"] },
      "tool_key": "metrics.query_semantic_signal.v1",
      "output_field": "series.placement_rejection_percent",
      "unit": "percent",
      "aggregation": "avg",
      "thresholds": {
        "mode": "absolute",
        "direction": "above",
        "degraded": 1,
        "critical": 5
      }
    }
  ],
  "tool_refs": [
    "context.resolve_focus.v1",
    "topology.expand_neighbors.v1",
    "metrics.query_semantic_signal.v1",
    "evidence.search_logs.v1",
    "evidence.search_traces.v1",
    "domain.list_service_faults.v1"
  ],
  "limits": {
    "default_window_seconds": 300,
    "max_window_seconds": 86400,
    "max_nodes": 100,
    "max_relations": 200,
    "max_rows": 200,
    "max_evidence_refs": 100,
    "freshness_ttl_seconds": 60
  }
}
